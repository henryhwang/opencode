+      const matchingMessage = messagesList.find((m) => m.id === element.id)
+      if (matchingMessage) {
+        return matchingMessage
+      }
+    }
+
+    // Second, try to find elements with IDs that contain message IDs (assistant message parts)
+    for (const element of visibleElements) {
+      // Check if the element ID contains a message ID (e.g., "text-{partId}" where part belongs to a message)
